clc;
clear;
close all;

% AIRGUARD - AIR POLLUTION TREND ASSESSMENT

%% 1. INPUT DATA

time = 1:10;

Coimbatore = [35 38 42 45 48 52 55 58 60 62];
Chennai    = [45 50 55 62 68 75 82 88 95 102];
Erode      = [30 32 35 38 42 45 43 40 38 35];

limit = 60;

locations = {'Coimbatore','Chennai','Erode'};
data = [Coimbatore; Chennai; Erode];

% Demo time labels: 9 AM to 6 PM
timeLabels = {'9 AM','10 AM','11 AM','12 PM','1 PM',...
              '2 PM','3 PM','4 PM','5 PM','6 PM'};

%% 2. CHECK ENVIRONMENTAL LIMIT

disp('AIR POLLUTION EXCEEDANCE CHECK');
disp('=============================');

C_exceed = Coimbatore > limit;
Ch_exceed = Chennai > limit;
E_exceed = Erode > limit;

disp('Coimbatore:');
disp(C_exceed);

disp('Chennai:');
disp(Ch_exceed);

disp('Erode:');
disp(E_exceed);

%% 3. FIND EXCEEDED TIME PERIODS

C_time = time(C_exceed);
Ch_time = time(Ch_exceed);
E_time = time(E_exceed);

disp(' ');
disp('EXCEEDED TIME PERIODS');
disp('====================');

disp('Coimbatore:');
if isempty(C_time)
    disp('No exceedance');
else
    disp(timeLabels(C_time));
end

disp('Chennai:');
if isempty(Ch_time)
    disp('No exceedance');
else
    disp(timeLabels(Ch_time));
end

disp('Erode:');
if isempty(E_time)
    disp('No exceedance');
else
    disp(timeLabels(E_time));
end

%% 4. PLOT POLLUTION TRENDS

figure('Name','AirGuard Pollution Dashboard');

plot(time, Coimbatore, '-o', 'LineWidth', 2);
hold on;
plot(time, Chennai, '-s', 'LineWidth', 2);
plot(time, Erode, '-^', 'LineWidth', 2);

yline(limit, '--r', 'Environmental Limit', ...
      'LineWidth', 1.5);

xticks(time);
xticklabels(timeLabels);

xlabel('Time');
ylabel('PM2.5 Concentration (demo units)');
title('Air Pollution Trend Assessment');

legend('Coimbatore','Chennai','Erode','Limit', ...
       'Location','northwest');

grid on;
hold off;

%% 5. CURRENT POLLUTION VALUES

current_C = Coimbatore(end);
current_Ch = Chennai(end);
current_E = Erode(end);

current_values = [current_C current_Ch current_E];

%% 6. RISK CLASSIFICATION
% These are demo categories, not official health standards.

risk = cell(3,1);

for i = 1:3
    value = current_values(i);

    if value < 50
        risk{i} = 'NORMAL';
    elseif value < 75
        risk{i} = 'MODERATE';
    elseif value < 100
        risk{i} = 'HIGH';
    else
        risk{i} = 'CRITICAL';
    end
end

disp(' ');
disp('CURRENT AIR QUALITY RISK');
disp('========================');

for i = 1:3
    fprintf('%s: %.1f - %s\n', ...
        locations{i}, current_values(i), risk{i});
end

%% 7. TREND DETECTION

trend = cell(3,1);

for i = 1:3
    change = data(i,end) - data(i,1);

    if change > 5
        trend{i} = 'RISING';
    elseif change < -5
        trend{i} = 'FALLING';
    else
        trend{i} = 'STABLE';
    end
end

disp(' ');
disp('POLLUTION TREND');
disp('===============');

for i = 1:3
    fprintf('%s: %s\n', locations{i}, trend{i});
end

%% 8. AUTOMATIC ALERTS

disp(' ');
disp('AIR POLLUTION ALERTS');
disp('===================');

status = cell(3,1);

for i = 1:3
    if current_values(i) > limit
        status{i} = 'ALERT';
        fprintf('ALERT: %s exceeded the limit!\n', ...
            locations{i});
    else
        status{i} = 'SAFE';
        fprintf('%s: Within the demo limit.\n', ...
            locations{i});
    end
end

%% 9. HIGHEST CURRENT POLLUTION LOCATION

[highest_value, highest_index] = max(current_values);

disp(' ');
disp('HIGHEST POLLUTION LOCATION');
disp('==========================');

fprintf('Location: %s\n', locations{highest_index});
fprintf('PM2.5 Value: %.1f\n', highest_value);

%% 10. FINAL SUMMARY TABLE

Location = locations';
Current_PM25 = current_values';
Risk = risk;
Trend = trend;
Status = status;

Summary = table(Location, Current_PM25, Risk, Trend, Status);

disp(' ');
disp('FINAL AIR QUALITY SUMMARY');
disp('==========================');

disp(Summary);

%% 11. PEAK POLLUTION AND PEAK TIME

disp(' ');
disp('PEAK POLLUTION DETAILS');
disp('======================');

for i = 1:3
    [peak_value, peak_index] = max(data(i,:));

    fprintf('%s: %.1f at %s\n', ...
        locations{i}, peak_value, timeLabels{peak_index});
end

%% 12. CURRENT POLLUTION COMPARISON

figure('Name','Current Pollution Comparison');

bar(current_values);

xticks(1:3);
xticklabels(locations);

yline(limit, '--r', 'Demo Limit', 'LineWidth', 1.5);

ylabel('PM2.5 Concentration (demo units)');
title('Current Pollution by Location');

grid on;

disp(' ');
disp('AIRGUARD ANALYSIS COMPLETED');
